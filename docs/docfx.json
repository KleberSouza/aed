{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/material"
    ],
    "globalMetadata": {
      "_appFooter": "© 2025 - Algoritmos e Estruturas de Dados",
      "_appName": "AED",
      "_appTitle": "AED",
      "_tocMaxLevel": 3,
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    }
  }
}